<Bindings>
  <!-- Game menu > Key Bindings > AddOns (or Options > General > Show/hide key). -->
  <Binding name="AZEROTHGPS_TOGGLE" header="AZEROTHGPS" category="ADDONS">
    AzerothGPS_ToggleMap()
  </Binding>
  <!-- Quick Search: the map shown and its search box ready to type in (asked 2026-11-14). -->
  <Binding name="AZEROTHGPS_SEARCH" category="ADDONS">
    AzerothGPS_QuickSearch()
  </Binding>
  <!-- Target the route's next stop's NPC (1.3.14): the Target button's click, the player's own key (GPSFrame's
       G.MakeTargetButton; it does nothing while the button has no NPC to target). -->
  <Binding name="CLICK AzerothGPSTargetButton:LeftButton" category="ADDONS"/>
</Bindings>
